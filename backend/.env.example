# =============================================================================
# Backend Environment Variables (for Render deployment)
# =============================================================================
# Copy these values to your Render service environment variables dashboard
# Go to: Render Dashboard > Your Service > Environment
# =============================================================================

# =============================================================================
# LLM Provider Configuration
# Choose one: gemini, azure, openai, ollama
# =============================================================================
LLM_PROVIDER=gemini

# -----------------------------------------------------------------------------
# Gemini Configuration (Recommended for production)
# -----------------------------------------------------------------------------
# The Gemini LLM provider reads GOOGLE_API_KEY directly.
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional service-account JSON for Google Cloud features that require it.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# -----------------------------------------------------------------------------
# Azure OpenAI Configuration (Alternative)
# -----------------------------------------------------------------------------
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2024-02-15-preview
AZURE_DEPLOYMENT_NAME=gpt-4o

# -----------------------------------------------------------------------------
# OpenAI Configuration (Alternative)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# =============================================================================
# NVIDIA Hosted Embeddings (required for RAG)
# =============================================================================
# Create a key at build.nvidia.com, then set it only in the hosting provider's
# secret manager. The backend sends embeddings to NVIDIA; it does not load a
# SentenceTransformer model locally.
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBEDDING_DIMENSION=2048
NVIDIA_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_TIMEOUT_SECONDS=30
# Changing either the model or dimension creates a separate FAISS index;
# re-index uploaded PDFs under the new profile before serving RAG queries.

# NVIDIA Hosted Reranking (enabled for advanced RAG)
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
NVIDIA_RERANK_ENDPOINT=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-vl-1b-v2/reranking
NVIDIA_RERANK_TIMEOUT_SECONDS=30

# =============================================================================
# Text-to-Speech Configuration
# =============================================================================
TTS_PROVIDER=azure

# -----------------------------------------------------------------------------
# Azure TTS Configuration (Recommended)
# -----------------------------------------------------------------------------
AZURE_TTS_KEY=your_azure_tts_key_here
AZURE_TTS_REGION=eastasia
# The endpoint/deployment settings below are used only by the standalone
# generate_audio helper; the application podcast route uses AZURE_TTS_REGION.
AZURE_TTS_ENDPOINT=https://eastasia.api.cognitive.microsoft.com/
AZURE_TTS_DEPLOYMENT=tts
AZURE_TTS_VOICE=alloy
AZURE_TTS_API_VERSION=2025-03-01-preview

# -----------------------------------------------------------------------------
# Google TTS Configuration (Alternative)
# -----------------------------------------------------------------------------
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here
# Or use GOOGLE_APPLICATION_CREDENTIALS if already set above

# =============================================================================
# Adobe PDF Embed API (Optional - has fallback)
# =============================================================================
ADOBE_CLIENT_ID=your_adobe_client_id_here

# =============================================================================
# Authentication Configuration
# =============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
PERSISTENCE_BACKEND=supabase
SUPABASE_SECRET_KEY=your-server-only-secret-key-here
SUPABASE_STORAGE_BUCKET=documents
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Never enable development authentication shortcuts in production.
APP_ENV=production
AUTH_BYPASS_ENABLED=false
ALLOW_CLIENT_ID_FALLBACK=false

# =============================================================================
# Persistent Application Storage
# =============================================================================
# Supabase persists PDFs, metadata, chunks, and vectors. This local directory is
# only an ephemeral processing cache plus generated audio workspace on Render.
APP_DATA_DIR=/tmp/ai-pdf-reader

# =============================================================================
# CORS Configuration (Production)
# =============================================================================
# Comma-separated exact browser origins; do not include a trailing slash.
CORS_ORIGINS=https://your-app.vercel.app

# =============================================================================
# Server Configuration (Render defaults)
# =============================================================================
# Render uses PORT environment variable automatically
# PORT=8080  # Render sets this automatically

# =============================================================================
# Logging & Debug
# =============================================================================
# Uncomment for debugging
# DEBUG=true
# LOG_LEVEL=debug

# =============================================================================
# Render-Specific Notes
# =============================================================================
# 1. Set all secrets in Render's Environment tab; never commit real values.
# 2. Set CORS_ORIGINS to the exact Vercel production/custom-domain origin.
# 3. Apply both checked-in Supabase migrations before the first backend deploy.
# 4. Re-index uploaded PDFs whenever the embedding model or dimension changes.
