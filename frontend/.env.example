# =============================================================================
# Frontend Environment Variables (for Vercel deployment)
# =============================================================================
# Add these values in Vercel > Project > Settings > Environment Variables.
# =============================================================================

# =============================================================================
# Backend API URL
# =============================================================================
VITE_APP_ENV=production

# Development (local backend):
# VITE_API_URL=http://127.0.0.1:8080

# Production (Render backend - UPDATE THIS after deploying backend):
VITE_API_URL=https://your-backend-service.onrender.com
# Optional override. If omitted, the app converts VITE_API_URL to wss://.
# VITE_WS_URL=wss://your-backend-service.onrender.com

# =============================================================================
# Supabase Configuration (Authentication)
# =============================================================================
# 1. Create a Supabase project at https://supabase.com/dashboard
# 2. Navigate to Project Settings > API
# 3. Copy "Project URL" to VITE_SUPABASE_URL
# 4. Copy "anon public" key to VITE_SUPABASE_ANON_KEY
# 5. Apply the checked-in migrations under supabase/migrations

VITE_SUPABASE_URL=https://hbyrlshjrhytnyyucvfu.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# =============================================================================
# Development Auth Bypass
# =============================================================================
# Effective only in Vite development mode when VITE_APP_ENV=development.
# Keep disabled in production deploys.
VITE_AUTH_BYPASS_ENABLED=false
VITE_DEV_AUTH_EMAIL=ysaichaithu2005@gmail.com
VITE_DEV_AUTH_USER_ID=ysaichaithu2005@gmail.com

# =============================================================================
# Vercel-Specific Notes
# =============================================================================
# 1. All environment variables MUST start with VITE_ to be exposed to frontend
# 2. After setting env vars, trigger a new deploy for changes to take effect
# 3. Deploy the Render backend first, then set VITE_API_URL before the Vercel build
# 4. Never use service_role key - only use anon public key for security
